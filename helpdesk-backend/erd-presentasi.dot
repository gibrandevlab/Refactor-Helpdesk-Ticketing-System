
digraph ERD {

  graph [
    rankdir="LR",
    bgcolor="#F8FAFC",

    pad="0.45",
    margin="0.15",

    nodesep="0.55",
    ranksep="1.25",

    splines="ortho",
    overlap=false,

    newrank=true,
    compound=true,

    outputorder="edgesfirst",

    fontname="Helvetica"
  ];

  node [
    fontname="Helvetica",
    fontsize="9",
    margin="0"
  ];

  edge [
    color="#94A3B8",
    penwidth="1.35",
    arrowsize="0.65",
    arrowhead="vee",
    fontname="Helvetica",
    fontsize="7",
    fontcolor="#64748B"
  ];

  /*
   * ======================================================
   * TITLE
   * ======================================================
   */

  labelloc="t";
  label=<
    <TABLE
      BORDER="0"
      CELLBORDER="0"
      CELLPADDING="2"
    >
      <TR>
        <TD ALIGN="CENTER">
          <FONT
            FACE="Helvetica"
            COLOR="#0F172A"
            POINT-SIZE="20"
          >
            <B>ENTITY RELATIONSHIP DIAGRAM</B>
          </FONT>
        </TD>
      </TR>

      <TR>
        <TD ALIGN="CENTER">
          <FONT
            FACE="Helvetica"
            COLOR="#64748B"
            POINT-SIZE="10"
          >
            Database Schema &amp; Relationship Overview
          </FONT>
        </TD>
      </TR>
    </TABLE>
  >;

  /*
   * ======================================================
   * LEGEND
   * ======================================================
   */

  subgraph cluster_legend {
    label="";
    color="transparent";
    bgcolor="transparent";

    legend [
      shape=plain
      label=<
        <TABLE
          BORDER="1"
          COLOR="#CBD5E1"
          CELLBORDER="0"
          CELLSPACING="0"
          CELLPADDING="5"
          BGCOLOR="#FFFFFF"
        >

          <TR>
            <TD>
              <FONT
                FACE="Helvetica"
                COLOR="#0F172A"
                POINT-SIZE="8"
              >
                <B>LEGEND</B>
              </FONT>
            </TD>

            <TD>
              <FONT
                FACE="Helvetica"
                COLOR="#B91C1C"
                POINT-SIZE="8"
              >
                <B>PK</B>
              </FONT>
            </TD>

            <TD>
              <FONT
                FACE="Helvetica"
                COLOR="#1D4ED8"
                POINT-SIZE="8"
              >
                <B>FK</B>
              </FONT>
            </TD>

            <TD>
              <FONT
                FACE="Helvetica"
                COLOR="#64748B"
                POINT-SIZE="8"
              >
                Primary / Foreign Key
              </FONT>
            </TD>
          </TR>

        </TABLE>
      >
    ];
  }

  /*
   * ======================================================
   * TABLES
   * ======================================================
   */

  subgraph "cluster_0" {

    label="MASTER & OTHER";

    color="#E2E8F0";
    penwidth="1";
    style="rounded,dashed";

    fontname="Helvetica-Bold";
    fontsize="10";
    fontcolor="#475569";

    margin="16";


    "approval_ticket"
